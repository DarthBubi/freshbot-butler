      "TextCaptureDraft": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "quantity": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Quantity"
          },
          "category": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
